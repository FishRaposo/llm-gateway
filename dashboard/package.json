  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
