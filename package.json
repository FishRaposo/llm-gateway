{
  "name": "llm-gateway",
  "version": "1.1.0",
  "description": "A lightweight LLM operations gateway for routing, cost control, fallback, and auditability",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint .",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "benchmark:portfolio": "tsx scripts/benchmark_portfolio_gateway.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "gpt-tokenizer": "^4.1.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.3.0",
    "uuid": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
